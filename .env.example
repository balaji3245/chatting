# MongoDB Atlas Connection URL
DATABASE_URL="mongodb+srv://<username>:<password>@cluster0.zrbld9r.mongodb.net/private_chat_db?retryWrites=true&w=majority"

# Node Environment & Port
NODE_ENV="development"
PORT=3000

# Predefined Accounts (For Seed Script)
USER1_USERNAME="t"
USER1_DISPLAY_NAME="T"

USER2_USERNAME="adesh"
USER2_DISPLAY_NAME="Adesh"

# Shared Pattern Lock Sequence (0-1-2-4-6-7-8)
SHARED_PATTERN="0-1-2-4-6-7-8"

# Security & Session Secrets
SESSION_SECRET="change_this_to_a_random_64_char_hex_secret_in_production"

# Private Upload Vault Path
STORAGE_DIR="/var/lib/private-chat/uploads"
